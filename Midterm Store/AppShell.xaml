<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Midterm_Store.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Midterm_Store"
    Title="Midterm_Store">

    <TabBar>

        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
             Title="Checkout"
             ContentTemplate="{DataTemplate local:NewPage5}"
             Route="destinationPageSample" />

    </TabBar>

</Shell>
