<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm_Store.NewPage3"
             Title="Gravity Potion">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*"
          RowSpacing="5"
          Margin="10">
            <Image Source="gravitypotion.png" Grid.Row="0" HeightRequest="160"/>
            <Label Grid.Row="1" Grid.ColumnSpan="3"
                Text="Gravity Potion"
                FontSize="20"
                VerticalOptions="Center" 
                HorizontalOptions="Start" />
            <Label Grid.Row="2" Grid.ColumnSpan="3"
                Text="$13.99"
                TextColor="IndianRed"
                FontSize="18"
                VerticalOptions="Center" 
                HorizontalOptions="Start" />
            <Label Grid.Row="3" Grid.ColumnSpan="3"
                Text="This potion manipulates the gravity around the user. Users should ensure that they are in a contained space before consuming."
                VerticalOptions="Center" 
                HorizontalOptions="Start" />
            <Label Grid.Row="4" Grid.ColumnSpan="3"
                Text="Made with 100% real penguin feathers."
                VerticalOptions="Center" 
                HorizontalOptions="Start" />
            <Label Grid.Row="5" Grid.ColumnSpan="3"
                Text="In Stock"
                VerticalOptions="Center" 
                HorizontalOptions="Start" 
                TextColor="DarkSeaGreen"/>
            <Label Grid.Row="6" Grid.ColumnSpan="3"
                Text="Quantity"
                VerticalOptions="Center" 
                HorizontalOptions="Start" />
            <Entry Grid.Row="7"
                x:Name="orderEntry"
                Text=""
                Placeholder="How many?"
                Keyboard="Numeric"
                FontSize="18" />
            <Button Grid.Row="8"
                x:Name="FirstBack"
                Text="Add to Cart" 
                Clicked="Ordered"
                HorizontalOptions="Fill" />
            <Label Grid.Row="9"
                Text="No Number Collected Yet" 
                HorizontalTextAlignment="Start" 
                x:Name="resultLabel"/>
        </Grid>
    </ScrollView>
</ContentPage>