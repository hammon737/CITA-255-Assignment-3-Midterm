<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm_Store.NewPage5"
             Title="Checkout">
    <ScrollView>
        <Grid RowDefinitions ="Auto,*,Auto,Auto,Auto"
              Padding="40"
              RowSpacing="16">
            <Label 
                Grid.Row="0" Grid.ColumnSpan="3"
                Text="Your Basket:"
                Style="{StaticResource titles}"/>
            <Border Grid.Row="1"
                        StrokeThickness="1"
                        Padding="4">
                <CollectionView x:Name="CartView">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}"
                                           Padding="12,10" 
                                           Style="{StaticResource Lists}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label x:Name="empty"
                                    Grid.Row="1" Grid.ColumnSpan="3"
                                    Text="Nothing in here yet."
                                    FontSize="15"
                                    TextColor="Grey"
                                    VerticalOptions="Start" 
                                    HorizontalOptions="Start" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>

            <Label
                 Grid.Row="2"
                 x:Name="totalLabel"
                 Text=""
                 FontSize="15"
                 FontAttributes="Italic"
                 VerticalOptions="End" 
                 HorizontalOptions="End"/>
            <Button
                Grid.Row="3"
                x:Name="Check"
                Text="Check Out" 
                HorizontalOptions="Fill" 
                VerticalOptions="End"
                Margin="20"
                Clicked="checkingOut"/>
            <Label
                Grid.Row="4"
                x:Name="purchaseLabel"
                Text=""
                HorizontalOptions="Center"
                FontSize="20"
                TextColor="MediumSeaGreen"/>


        </Grid>
        
             
    </ScrollView>
</ContentPage>